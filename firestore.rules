rules_version = '2';

// قواعد حماية قاعدة بيانات نظام أكاديمية الذكاء الاصطناعي الدولية
// الأدوار: admin (الإدارة) - deputy (نائب المدير) - registrar (مسؤول التسجيل)
//          secretary (السكرتير) - trainer (المدرب)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function me() { return get(userPath(request.auth.uid)).data; }
    function active() {
      return signedIn() && exists(userPath(request.auth.uid)) && me().active == true;
    }
    function hasRole(roles) { return active() && me().role in roles; }

    function isAdmin()    { return hasRole(['admin']); }
    function isManager()  { return hasRole(['admin', 'deputy']); }
    function canCourses() { return hasRole(['admin', 'deputy', 'registrar']); }
    function isStaff()    { return hasRole(['admin', 'deputy', 'registrar', 'secretary']); }
    function isTrainer()  { return hasRole(['trainer']); }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // كل ما لم يذكر ممنوع
    match /{document=**} {
      allow read, write: if false;
    }

    // علامة إتمام الإعداد الأول (إنشاء حساب الإدارة الأول)
    match /meta/setup {
      allow read: if true;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/meta/setup)
        && getAfter(userPath(request.auth.uid)).data.role == 'admin';
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if active() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && !exists(/databases/$(database)/documents/meta/setup)
            && existsAfter(/databases/$(database)/documents/meta/setup)
            && request.resource.data.role == 'admin'
            && request.resource.data.active == true);
      allow update: if isAdmin()
        || (active() && request.auth.uid == uid && onlyChanges(['name', 'phone', 'updatedAt']));
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    match /settings/{id} {
      allow read: if active();
      allow write: if isManager();
    }

    match /students/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isManager();
    }

    match /courses/{id} {
      allow read: if isStaff() || (isTrainer() && resource.data.trainerId == request.auth.uid);
      allow create, update: if canCourses();
      allow delete: if isManager();
    }

    // تسجيل الطالب في دورة (بدون أي بيانات مالية - يراه المدرب)
    match /enrollments/{id} {
      allow read: if isStaff() || (isTrainer() && resource.data.trainerId == request.auth.uid);
      allow create, update: if isStaff();
      allow delete: if canCourses();
    }

    // الحساب المالي للتسجيل (لا يراه المدرب)
    match /accounts/{id} {
      allow read, create, update: if isStaff();
      allow delete: if canCourses();
    }

    match /attendance/{id} {
      allow read: if isStaff() || (isTrainer() && resource.data.trainerId == request.auth.uid);
      allow create, update: if isStaff()
        || (isTrainer()
            && request.resource.data.trainerId == request.auth.uid
            && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.trainerId == request.auth.uid);
      allow delete: if isManager();
    }

    match /products/{id} {
      allow read: if isStaff();
      allow create: if canCourses();
      allow update: if canCourses() || (isStaff() && onlyChanges(['stock', 'updatedAt']));
      allow delete: if isManager();
    }

    match /sales/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isManager();
    }
  }
}
